# Where the app gets its data: "live" (default) talks to app-api under /api; "mock" uses public/mock/ and localStorage.
VITE_API_MODE=live
# Where Vite forwards /api in development (npm run dev). app-api listens on port 3000 by default.
API_PROXY_TARGET=http://127.0.0.1:3000
# Fake network delay for the mock backend, in milliseconds. 0 turns it off. Only used with VITE_API_MODE=mock.
VITE_MOCK_LATENCY_MS=120
