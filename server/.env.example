# app-api settings. Every value is optional; the defaults suit `npm run dev` on a workstation.
PORT=3000
HOST=0.0.0.0
# SQLite file holding the household. Defaults to server/data/app.db.
DATABASE_PATH=./data/app.db
# Research fixtures (questionnaire, device library, declarations). Defaults to ../public/mock.
FIXTURES_DIR=../public/mock
# The PPD gateway, reached from app-api only.
GATEWAY_URL=http://127.0.0.1:8080
LOG_LEVEL=info
