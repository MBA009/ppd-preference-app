# app-api settings. Every value is optional for local development (APP_ENV=development).
# Any *_TOKEN can also be read from a file: set NAME_FILE=/run/secrets/name instead of NAME.

PORT=3000
HOST=0.0.0.0
# development: a fixed local operator, no sign-in. production: Cloudflare Access required (fails to start without it).
APP_ENV=development
# SQLite file holding the household, publications, commands and telemetry. Defaults to server/data/app.db.
DATABASE_PATH=./data/app.db
# Research fixtures (questionnaire, device library, declarations). Defaults to ../public/mock.
FIXTURES_DIR=../public/mock
# Which gateway devices are real or simulated, and how to present them. Defaults to config/devices.json.
DEVICE_REGISTRY=./config/devices.json

# The PPD gateway origin. app-api discovers its API from /.well-known/ppd. The browser never calls it.
GATEWAY_URL=http://127.0.0.1:8080
# The gateway's PPD_OPERATOR_TOKEN, sent on its operator routes.
GATEWAY_OPERATOR_TOKEN=
# Mutual TLS to the gateway (cloud). GATEWAY_TLS_SERVER_NAME is the name on the gateway certificate.
GATEWAY_TLS_SERVER_NAME=
GATEWAY_CA_FILE=
GATEWAY_CLIENT_CERT_FILE=
GATEWAY_CLIENT_KEY_FILE=
GATEWAY_TIMEOUT_MS=4000

# The gateway's PPD_DEMO_APP_API_TOKEN: it presents this on /internal/* when relaying device telemetry
# and command polling. Unset turns those callbacks off.
INTERNAL_SERVICE_TOKEN=

# Cloudflare Access (production): the team domain (team.cloudflareaccess.com) and the application's AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Comma-separated emails that may publish rules and drive devices. Empty: every signed-in person.
OPERATOR_EMAILS=

# 1 shows the gateway's router-only checks (DHCP, ARP, Wi-Fi) on System status. Leave off in the cloud.
ROUTER_CHECKS=
LOG_LEVEL=info
